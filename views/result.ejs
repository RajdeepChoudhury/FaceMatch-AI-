<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Face Match Result</title>

    <style>

        *{
            margin:0;
            padding:0;
            box-sizing:border-box;
        }

        body{
            background:#0f172a;
            font-family:Arial, sans-serif;
            color:white;
            padding:40px;
        }

        .container{
            max-width:1400px;
            margin:auto;
        }

        .title{
            text-align:center;
            margin-bottom:40px;
        }

        .title h1{
            font-size:48px;
            margin-bottom:10px;
        }

        .title p{
            color:#94a3b8;
            font-size:18px;
        }

        .score-box{

            width:260px;
            height:260px;

            margin:0 auto 50px;

            border-radius:50%;

            border:10px solid #22c55e;

            display:flex;
            align-items:center;
            justify-content:center;
            flex-direction:column;

            background:#111827;

            box-shadow:
                0 0 40px rgba(34,197,94,0.3);
        }

        .score-box h2{
            font-size:60px;
        }

        .score-box span{
            color:#94a3b8;
            margin-top:10px;
        }

        .result-image{

            width:100%;
            border-radius:20px;
            border:4px solid #22c55e;

            margin-bottom:50px;

            box-shadow:
                0 10px 30px rgba(0,0,0,0.5);
        }

        .details-grid{

            display:grid;

            grid-template-columns:
                repeat(auto-fit, minmax(300px, 1fr));

            gap:25px;
        }

        .card{

            background:#111827;

            padding:25px;

            border-radius:20px;

            border:1px solid rgba(255,255,255,0.08);

            box-shadow:
                0 5px 20px rgba(0,0,0,0.3);
        }

        .card h3{
            margin-bottom:20px;
            color:#22c55e;
            font-size:24px;
        }

        .feature{
            margin-bottom:18px;
        }

        .feature-top{
            display:flex;
            justify-content:space-between;
            margin-bottom:8px;
        }

        .bar{
            width:100%;
            height:10px;
            background:#1e293b;
            border-radius:20px;
            overflow:hidden;
        }

        .bar-fill{
            height:100%;
            background:#22c55e;
            border-radius:20px;
        }

        .verdict{
            font-size:28px;
            font-weight:bold;
            margin-bottom:20px;
        }

        .good{
            color:#22c55e;
        }

        .medium{
            color:#f59e0b;
        }

        .bad{
            color:#ef4444;
        }

        .info{
            line-height:2;
            color:#cbd5e1;
            font-size:16px;
        }

        .download-btn{

            display:inline-block;

            margin-top:40px;

            padding:14px 28px;

            background:#2563eb;

            color:white;

            text-decoration:none;

            border-radius:12px;

            font-weight:bold;

            transition:0.3s;
        }

        .download-btn:hover{
            background:#1d4ed8;
        }

    </style>

</head>

<body>

<div class="container">

    <!-- TITLE -->

    <div class="title">

        <h1>Face Match Analysis</h1>

        <p>AI powered facial comparison result</p>

    </div>

    <!-- SCORE -->

    <div class="score-box">

        <h2><%= overall %>%</h2>

        <span>Overall Match</span>

    </div>

    <!-- RESULT IMAGE -->

    <img
        src="/<%= image %>"
        class="result-image"
        alt="Face Match Result"
    >

    <!-- DETAILS -->

    <div class="details-grid">

        <!-- FEATURE ANALYSIS -->

        <div class="card">

            <h3>Feature Match Analysis</h3>

            <% for(let key in scores){ %>

                <div class="feature">

                    <div class="feature-top">

                        <span><%= key %></span>

                        <span><%= scores[key] %>%</span>

                    </div>

                    <div class="bar">

                        <div
                            class="bar-fill"
                            style="width:<%= scores[key] %>%"
                        ></div>

                    </div>

                </div>

            <% } %>

        </div>

        <!-- AI VERDICT -->

        <div class="card">

            <h3>AI Verdict</h3>

            <% if(overall >= 95){ %>

                <div class="verdict good">
                    ✔ Same Person Detected
                </div>

                <div class="info">

                    <p>
                        The AI system found extremely high
                        similarity between both facial structures.
                    </p>

                    <p>
                        Match confidence is very strong and
                        both images are likely of the same person.
                    </p>

                </div>

            <% } else if(overall >= 70){ %>

                <div class="verdict medium">
                    ⚠ Similar Facial Features
                </div>

                <div class="info">

                    <p>
                        Some facial regions appear similar,
                        including face shape and structure.
                    </p>

                    <p>
                        However, the system cannot confirm
                        that both images belong to the same person.
                    </p>

                </div>

            <% } else { %>

                <div class="verdict bad">
                    ✖ Different Persons
                </div>

                <div class="info">

                    <p>
                        The AI system detected low facial
                        similarity between the two images.
                    </p>

                    <p>
                        Facial structure, texture and
                        feature patterns differ significantly.
                    </p>

                </div>

            <% } %>

        </div>

        <!-- TECHNICAL DETAILS -->

        <div class="card">

            <h3>Technical Details</h3>

            <div class="info">

                <p>✔ Face Detection: Success</p>

                <p>✔ Feature Extraction: Completed</p>

                <p>✔ Similarity Analysis: Completed</p>

                <p>✔ Facial Region Mapping: Active</p>

                <p>✔ Detection Method: OpenCV Haar Cascade</p>

                <% if(overall >= 95){ %>

                    <p>✔ Match Status: Confirmed Match</p>

                    <p>✔ AI Confidence Level: Very High</p>

                <% } else if(overall >= 70){ %>

                    <p>✔ Match Status: Partial Similarity</p>

                    <p>✔ AI Confidence Level: Medium</p>

                <% } else { %>

                    <p>✔ Match Status: No Match</p>

                    <p>✔ AI Confidence Level: Low</p>

                <% } %>

            </div>

        </div>

    </div>

    <!-- DOWNLOAD BUTTON -->

    <center>

        <a
            href="/<%= image %>"
            download
            class="download-btn"
        >
            Download Result
        </a>

    </center>

</div>

</body>
</html>